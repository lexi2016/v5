+        def reply_m14(self,query):
+            # Only M14 hands off its heavy-reader slot before network output.
+            # Keep one original cold read at a time; retain only bounded bytes.
+            record=None;digest=None;reason=None
+            try:
+                try:
+                    from .m14_readonly import MAX_PAGE_BYTES
+                    record,digest=read_response(config,root,M14_ROUTE,query)
+                    status=record['status_code'];data=canonical_bytes(record['payload'])
+                    if len(data)>MAX_PAGE_BYTES:raise ValueError('M14_PAGE_LIMIT')
+                except TimeoutError:status,reason=503,'RESEARCH_READER_TIMEOUT'
+                except FileNotFoundError:status,reason=503,'MODULE_RESULT_NOT_AVAILABLE'
+                except ValueError as error:
+                    status,reason=(503,'MODULE_BUSY') if str(error)=='MODULE_PUBLICATION_BUSY' else (409,'MODULE_RESULT_INVALID')
+                except (TypeError,KeyError,OSError,RecursionError):status,reason=409,'MODULE_RESULT_INVALID'
+                if reason is not None:
+                    digest=None
+                    data=canonical_bytes(dict(status='CANNOT_CONFIRM',reason_codes=[reason],module_id=config['module_id']))
+            finally:
+                record=None
+                m14_read_slot.release()
+            # At most the existing eight HTTP slots may retain a <=256 KiB body.
+            # No artifact/record remains held when another M14 read is admitted.
+            self.send_response(status)
+            self.send_header('Content-Type','application/json; charset=utf-8');self.send_header('Content-Length',str(len(data)))
+            self.send_header('Cache-Control','no-store');self.send_header('X-Content-Type-Options','nosniff')
+            self.send_header('X-V5-Module',config['module_id']);self.send_header('X-V5-Release',config['release_id'])
+            if digest:self.send_header('X-V5-Record-SHA256',digest)
+            self.end_headers()
+            try:self.wfile.write(data)
+            except OSError:pass
         def error(self,status,reason):self.reply(status,dict(status='CANNOT_CONFIRM',reason_codes=[reason],module_id=config['module_id']))
