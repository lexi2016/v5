-def _verify_runtime(v5_src):
-    root = Path(v5_src).parent
-    for relative, expected in RUNTIME_SHA256.items():
-        if _sha(_read_file(root / relative)) != expected:
-            raise ValueError('M03_SAVED_RUNTIME_SHA_MISMATCH:' + relative)
