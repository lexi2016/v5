-def _sha(raw):
-    return hashlib.sha256(raw).hexdigest()
-
-
-def _sha_value(value):
-    if not isinstance(value, str) or re.fullmatch(r'[0-9a-f]{64}', value) is None:
-        raise ValueError('M03_SAVED_SHA_REQUIRED')
-    return value
-
