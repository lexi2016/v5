+    if (snapshot.get('status')!='READY'
+        or type(snapshot.get('quote_count')) is not int or snapshot['quote_count']<0
+        or type(snapshot.get('theme_count')) is not int or snapshot['theme_count']<0):
+        raise ValueError('M03_SAVED_RESULT_CONTRACT')
