+def _m03_saved_public_view(result):
+    """Accept only the pinned saved-reader projection; no private roots."""
+    from .contracts import sha,aware
+    fields={'schema_version','status','source_status','readback_verified',
+        'request_sha256','request_identity_sha256','binding_sha256','source_sha256',
+        'request','identity','market_snapshot','runtime_commit','orchestrator_sha256',
+        'owner_descriptor_sha256',*FLAGS}
+    if (not isinstance(result,dict) or set(result)!=fields
+        or result.get('schema_version')!='v5.m03.saved_binding_public_view.v1'
+        or result.get('status')!='VALIDATED_SOURCE_BINDING'
+        or result.get('source_status') not in {'READY','READY_EMPTY'}
+        or result.get('readback_verified') is not True
+        or any(result.get(key) is not False for key in FLAGS)
+        or result.get('runtime_commit')!='efeaeb8fc04474b1f38ebda98b35953b580049df'):
+        raise ValueError('M03_SAVED_RESULT_CONTRACT')
+    for key in ('request_sha256','request_identity_sha256','binding_sha256',
+                'orchestrator_sha256','owner_descriptor_sha256'):sha(result[key])
+    if set(result['source_sha256'])!={'payload','receipt','manifest'}:
+        raise ValueError('M03_SAVED_RESULT_CONTRACT')
+    for value in result['source_sha256'].values():sha(value)
+    if set(result['request'])!={'trade_date','session','capture_phase','cutoff'}:
+        raise ValueError('M03_SAVED_RESULT_CONTRACT')
