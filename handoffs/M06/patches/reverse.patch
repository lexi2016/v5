+def _sha(p:Path):
+    h=hashlib.sha256()
+    with p.open("rb") as f:
+        for b in iter(lambda:f.read(1024*1024),b""): h.update(b)
+    return h.hexdigest()
+
+def _inventory(root):
+    root=Path(root)
+    out={}
+    for p in sorted(root.rglob("*")):
+        if p.is_symlink(): raise ValueError("HK_SYMLINK_INPUT")
+        if p.is_file():
+            rel=str(p.relative_to(root))
+            out[rel]=_sha(p)
+    return out
+
