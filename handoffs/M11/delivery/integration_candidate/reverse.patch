-class Refused(ValueError):
-    pass
-
-
-def encoded(value):
-    return json.dumps(value, sort_keys=True, separators=(',', ':'), ensure_ascii=False, allow_nan=False).encode()
-
-
-def digest(value):
-    return hashlib.sha256(encoded(value)).hexdigest()
-
-
-def exact_date(value):
-    if not isinstance(value, str) or not re.fullmatch(r'\d{8}|\d{4}-\d{2}-\d{2}', value):
-        raise Refused('DATE_INVALID')
-    try:
-        return date.fromisoformat(value).isoformat()
-    except ValueError as error:
-        raise Refused('DATE_INVALID') from error
-
-
-def stamp(value):
-    try:
-        value = datetime.fromisoformat(value)
-        if value.tzinfo is None:
-            raise ValueError('unbound')
-        return value
-    except (TypeError, ValueError) as error:
-        raise Refused('TIME_UNBOUND') from error
-
-
-def opaque(value):
-    if not isinstance(value, str) or not re.fullmatch('[0-9a-f]{32}', value):
-        raise Refused('OPAQUE_ID_INVALID')
-    return value
-
-
-def safe_path(value):
-    path = Path(value)
-    if not path.is_absolute() or '..' in path.parts or any(p.is_symlink() for p in [path, *path.parents]):
-        raise Refused('PATH_BOUNDARY_INVALID')
-    return path
-
