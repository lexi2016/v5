-def create_server(service, *, host='127.0.0.1', port=0):
-    if host!='127.0.0.1': raise Refused('LOOPBACK_ONLY')
-    class Handler(BaseHTTPRequestHandler):
-        def log_message(self,*args): pass
-        def setup(self):
-            super().setup(); self.connection.settimeout(5)
-        def respond(self,status,body):
-            data=encoded(body)
-            self.send_response(status); self.send_header('Content-Type','application/json; charset=utf-8')
-            self.send_header('Content-Length',str(len(data)));self.send_header('Cache-Control','no-store')
-            self.send_header('X-Content-Type-Options','nosniff');self.end_headers();self.wfile.write(data)
-        def do_GET(self): self.dispatch()
-        def do_POST(self): self.dispatch()
-        def dispatch(self):
-            try:
-                hosts={f'127.0.0.1:{self.server.server_port}',f'localhost:{self.server.server_port}'}
-                if self.headers.get('Host') not in hosts: raise Refused('HOST_REJECTED')
-                if self.headers.get('Origin') and self.headers['Origin'] not in {'http://'+h for h in hosts}:
-                    raise Refused('ORIGIN_REJECTED')
-                if self.headers.get('Transfer-Encoding') or len(self.path)>1024: raise Refused('REQUEST_INVALID')
-                parsed=urlsplit(self.path)
-                if parsed.scheme or parsed.netloc or parsed.fragment: raise Refused('REQUEST_INVALID')
-                query=parse_qs(parsed.query,strict_parsing=True,max_num_fields=2)
-                length=int(self.headers.get('Content-Length','0'))
-                if length<0 or length>4096: raise Refused('BODY_SIZE_INVALID')
-                if self.command=='GET':
-                    if length: raise Refused('GET_BODY_REJECTED')
-                    if parsed.path=='/api/v5/m11/day' and set(query)=={'date'} and len(query['date'])==1:
-                        return self.respond(200,service.get_day(query['date'][0]))
-                    if parsed.path=='/api/v5/m11/job' and set(query)=={'job_id'} and len(query['job_id'])==1:
-                        return self.respond(200,service.get_job(query['job_id'][0]))
-                    raise Refused('ROUTE_NOT_FOUND')
-                if parsed.path!='/api/v5/m11/generate' or query: raise Refused('ROUTE_NOT_FOUND')
-                if self.headers.get('Content-Type','').split(';')[0]!='application/json': raise Refused('BODY_TYPE_INVALID')
-                raw=self.rfile.read(length)
-                if len(raw)!=length: raise Refused('BODY_INCOMPLETE')
-                body=json.loads(raw)
-                if not isinstance(body,dict) or set(body)!={'date','intent_id'}: raise Refused('BODY_FIELDS_INVALID')
-                return self.respond(202,service.submit(body['date'],body['intent_id']))
-            except Refused as error:
-                code=str(error); status=409 if code in {'ATTEMPT_REQUIRES_REVIEW','INTENT_BINDING_CHANGED'} else 400
-                if code in {'ROUTE_NOT_FOUND','JOB_NOT_FOUND'}: status=404
-                self.respond(status,{'status':'CANNOT_CONFIRM','error_code':code,**SAFETY})
-            except (ValueError,TypeError,OSError):
-                self.respond(400,{'status':'CANNOT_CONFIRM','error_code':'REQUEST_INVALID',**SAFETY})
-    return ThreadingHTTPServer((host,port),Handler)
