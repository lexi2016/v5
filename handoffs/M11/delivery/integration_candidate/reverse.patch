-@dataclass(frozen=True)
-class BoundPlan:
-    binding: object
-    target_date: str
-    cutoff: str
-    sources: list
-    slot: str | None = None
-
-    @property
-    def operation(self):
-        return 'capture' if self.slot else 'generate'
-
-    def key(self):
-        return digest({'date': self.target_date, 'slot': self.slot, 'cutoff': self.cutoff,
-                       'sources': self.sources, 'binding': {k: str(v) for k, v in vars(self.binding).items()}})
-
-    def validate(self):
-        if exact_date(self.target_date) != self.target_date:
-            raise Refused('PLAN_DATE_MUST_BE_ISO')
-        cutoff = stamp(self.cutoff)
-        if cutoff.astimezone(SHANGHAI).date().isoformat() != self.target_date:
-            raise Refused('CUTOFF_DATE_MISMATCH')
-        if self.slot is not None and self.slot not in SLOTS:
-            raise Refused('SLOT_INVALID')
-        if not isinstance(self.sources, list) or not self.sources:
-            raise Refused('SOURCE_AVAILABILITY_UNKNOWN')
-        for source in self.sources:
-            if not isinstance(source, dict) or not re.fullmatch('[0-9a-f]{64}', str(source.get('sha256', ''))):
-                raise Refused('SOURCE_SHA_REQUIRED')
-            available = stamp(source.get('available_at'))
-            if available > cutoff:
-                raise Refused('SOURCE_LATE')
-            for field in ('event_time', 'published_at', 'observed_at'):
-                if stamp(source.get(field)) > available:
-                    raise Refused('SOURCE_TIME_ORDER')
-        self.binding.validate()
-        encoded(self.sources)
