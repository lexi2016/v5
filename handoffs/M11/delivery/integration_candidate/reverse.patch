-SLOTS = ('09:25', '09:35', '10:00', '11:30', '14:00', '15:00')
-SHANGHAI = ZoneInfo('Asia/Shanghai')
-SAFETY = {'production_allowed': False, 'buy_gate_updated': False, 'orders_sent': False}
