-def public_tree(value):
-    """Drop owner-local path/provider metadata from browser projections."""
-    if isinstance(value, dict):
-        return {k: public_tree(v) for k, v in value.items()
-                if not any(token in k.lower() for token in ('path', 'root', 'provider', 'credential', 'token', 'secret'))}
-    if isinstance(value, list):
-        return [public_tree(v) for v in value]
-    return value
