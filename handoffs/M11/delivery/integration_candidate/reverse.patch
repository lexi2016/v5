-def slot_due(day, slot, now):
-    if not isinstance(now, datetime) or now.tzinfo is None:
-        raise Refused('CLOCK_UNBOUND')
-    local = now.astimezone(SHANGHAI)
-    if slot not in SLOTS or local.date().isoformat() != exact_date(day):
-        return False
-    # Exact owner semantics: integer minute drift, inclusive 0..8. +08:59 passes.
-    drift = local.hour * 60 + local.minute - int(slot[:2]) * 60 - int(slot[3:])
-    return 0 <= drift <= 8
