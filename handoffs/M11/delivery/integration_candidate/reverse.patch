-def default_owner(operation, binding, **kwargs):
-    from v5_shadow.m11.daily import capture, generate
-    return (capture if operation == 'capture' else generate)(binding, **kwargs)
-
-
-def default_readback(binding, operation, identity):
-    from v5_shadow.m11.intraday_capsule import IntradayCapsuleStore, M11Slot
-    root = binding.archive_root / ('intraday' if operation == 'capture' else 'daily')
-    return IntradayCapsuleStore(root).read_verified(M11Slot(**identity))
