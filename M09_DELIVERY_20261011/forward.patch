+_ORIGINAL_IMPORT = builtins.__import__
+_LOAD_LOCK = threading.RLock()
+_NAMESPACE = None
+_PANEL_BINDING: ContextVar[Any] = ContextVar("m09_admitted_frame_binding", default=None)
