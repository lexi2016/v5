-        clocks = iter([aware(t) for t in simulation['clocks']])
-        if not simulation['clocks'] or simulation['clocks'][0] != request['research_cutoff']:
-            raise ValueError('M17_SIMULATED_CLOCK_CONTRACT')
-        result = simulation['result']
