{
  "runtime_root": "${ISOLATED_P0_RUNTIME_ROOT}",
  "composition": "${P0_COMPOSITION_JSON}",
  "module_api": {
    "host": "127.0.0.1",
    "mode": "READ_ONLY"
  },
  "daily": {
    "enabled": false,
    "bundle_root": "${INDEPENDENT_BUNDLE_ROOT}",
    "ledger_root": "${INDEPENDENT_P0_LEDGER_ROOT}",
    "hk_preselection_daily": {
      "enabled": false,
      "delivery_root": "${MARKED_UPSTREAM_M06_INPUT_DELIVERY_ROOT}",
      "full_day_window": {
        "start": "${CONFIRMED_FULL_DAY_START_HH_MM}",
        "end": "${CONFIRMED_FULL_DAY_END_HH_MM}"
      },
      "half_day_window": "${CONFIRMED_WINDOW_OBJECT_OR_NULL_FOR_EXPLICIT_SKIP}",
      "execution_budget_seconds": "${EXPLICIT_INTEGER_BUDGET_AT_LEAST_TWO_PROCESS_TIMEOUTS}",
      "execution_mode": "NATURAL",
      "production_method": "GENERATE_IF_ABSENT"
    },
    "hk_preselection": {
      "enabled": false,
      "python_executable": "${EXISTING_HK02_VENV_LAUNCH_PATH}",
      "python_sha256": "${EXISTING_PYTHON_RAW_SHA256}",
      "timeout_seconds": 1200,
      "store_root": "${INDEPENDENT_SOURCE_SNAPSHOT_ROOT}",
      "asset_root": "${FROZEN_ASSET_ROOT}",
      "private_root": "${NEW_MARKED_M06_OUTPUT_ROOT}",
      "python_venv": {
        "root": "${EXISTING_VENV_CANONICAL_ROOT}",
        "realpath": "${PINNED_REAL_BINARY_PATH}",
        "pyvenv_cfg_sha256": "${PYVENV_CFG_RAW_SHA256}",
        "symlink_sha256": "${LAUNCH_READLINK_TEXT_SHA256}"
      }
    }
  }
}
